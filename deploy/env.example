# Copy to /etc/surfski/env (root:root, mode 600). Never commit it or bake it into the image.
# Generate the four secrets with: python3 scripts/gen_secrets.py
BASE_URL=https://mcp.example.com
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Google *primary* addresses of the Claude users allowed to log in (aliases won't match).
ALLOWED_USERS=alice@example.com,bob@example.com
# And/or whole Workspace domains (primary domain, exact match; gmail.com etc. are refused).
# ALLOWED_DOMAINS=example.com
JWT_SIGNING_KEY=
STORAGE_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY=
STATE_SECRET=
DATA_DIR=/data
LOG_LEVEL=INFO
# Optional: per-owner token keys (owner=fernetkey,owner=fernetkey); falls back to TOKEN_ENCRYPTION_KEY
# TOKEN_ENCRYPTION_KEYS=
# Optional: override the MCP client redirect allowlist (defaults to Claude's callbacks)
# ALLOWED_CLIENT_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# Optional: per-owner tool calls per minute (default 60)
# RATE_LIMIT_PER_MINUTE=60
